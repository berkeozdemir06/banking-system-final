# BIST Equity Intelligence Agent — Environment Variables
# Copy this file to .env and fill in your API keys

# ── LLM (Groq — Free Tier) ────────────────────────────────
# Get key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Embeddings (Nomic) ────────────────────────────────────
# Get key from: https://atlas.nomic.ai
NOMIC_API_KEY=your_nomic_api_key_here

# ── Data Extraction (Firecrawl) ───────────────────────────
# Get key from: https://www.firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ── Memory (Mem0) ─────────────────────────────────────────
# Get key from: https://mem0.ai
MEM0_API_KEY=your_mem0_api_key_here

# ── Observability ─────────────────────────────────────────
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=bist-rag-agent
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# ── App Settings ──────────────────────────────────────────
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
EMBED_MODEL=nomic-embed-text-v1.5
CHROMA_PATH=./data/chroma_db
LOG_LEVEL=INFO
